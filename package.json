{
	"name": "sokos-react-template",
	"version": "1.0.0",
	"description": "Mikrofrontend for Utbetalingsportalen",
	"type": "module",
	"scripts": {
		"dev": "vite --mode mock",
		"dev:backend": "vite --mode backend",
		"build": "tsc && vite build",
		"playwright": "playwright test",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@navikt/aksel-icons": "8.20.1",
		"@navikt/ds-css": "8.20.1",
		"@navikt/ds-react": "8.20.1",
		"axios": "1.21.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"swr": "2.5.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@axe-core/playwright": "4.14.0",
		"@navikt/aksel-stylelint": "8.20.1",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"msw": "2.15.0",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vite-plugin-css-injected-by-js": "5.0.3"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard",
			"@navikt/aksel-stylelint/recommended"
		],
		"rules": {
			"selector-class-pattern": "^[a-z][a-z0-9-]*(__[a-z][a-z0-9-]*)*(--[a-z][a-z0-9-]*)?$",
			"custom-property-pattern": "[a-z][a-zA-Z0-9-]+"
		},
		"ignoreFiles": "dist/**/*"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.10",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.10+sha512.672216f06e15c109b85471d49d3fbed17e6f03ead258df08c2bf5b4a5c33321ebfbf59476bce81325efada16ace0ac78548fd0bfcd7a51369e939182a3dd50e4"
}
