{
	"name": "sokos-react-template",
	"version": "1.0.0",
	"description": "Mikrofrontend for Utbetalingsportalen",
	"type": "module",
	"scripts": {
		"dev": "vite --mode mock",
		"dev:backend": "vite --mode backend",
		"build": "tsc && vite build",
		"playwright": "playwright test",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@grafana/faro-web-sdk": "2.8.2",
		"@navikt/aksel-icons": "7.39.0",
		"@navikt/ds-css": "7.39.0",
		"@navikt/ds-react": "7.39.0",
		"axios": "1.18.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"swr": "2.4.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@axe-core/playwright": "4.12.1",
		"@navikt/aksel-stylelint": "7.40.0",
		"@playwright/test": "1.62.0",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"husky": "9.1.7",
		"lint-staged": "17.2.0",
		"msw": "2.15.0",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vite-plugin-css-injected-by-js": "5.0.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard",
			"@navikt/aksel-stylelint/recommended"
		],
		"ignoreFiles": "dist/**/*"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.17.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
