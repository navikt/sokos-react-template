{
	"name": "sokos-react-template",
	"version": "1.0.0",
	"description": "Mikrofrontend for Utbetalingsportalen",
	"type": "module",
	"scripts": {
		"dev": "vite --mode mock",
		"dev:backend": "vite --mode backend",
		"build": "tsc && vite build",
		"playwright": "playwright test",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@navikt/aksel-icons": "8.15.0",
		"@navikt/ds-css": "8.15.0",
		"@navikt/ds-react": "8.15.0",
		"axios": "1.20.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"swr": "2.5.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@axe-core/playwright": "4.13.0",
		"@navikt/aksel-stylelint": "8.15.0",
		"@playwright/test": "1.63.0",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"msw": "2.15.0",
		"stylelint": "17.15.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vite-plugin-css-injected-by-js": "5.0.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard",
			"@navikt/aksel-stylelint/recommended"
		],
		"rules": {
			"selector-class-pattern": "^[a-z][a-z0-9-]*(__[a-z][a-z0-9-]*)*(--[a-z][a-z0-9-]*)?$",
			"custom-property-pattern": "[a-z][a-zA-Z0-9-]+"
		},
		"ignoreFiles": "dist/**/*"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.27.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
